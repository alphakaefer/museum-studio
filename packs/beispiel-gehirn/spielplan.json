  "einheiten": [
    {
      "id": "gebiet/wirklichkeit",
      "art": "gebiet",
      "name": "Wirklichkeit und Urteil",
      "reihenfolge": 1,
      "auftakt": "Hier beginnt das Museum mit einer unbequemen Frage: Wie verlässlich ist das, was du siehst und glaubst? Du erkundest, wie das Gehirn Wirklichkeit baut und wo es sich dabei verrechnet.",
      "abschluss": "Du kennst jetzt die typischen Stolpersteine des Urteilens und ein paar Werkzeuge, sie zu umgehen. Der Weg in die Klinik steht dir offen."
    },
    {
      "id": "gebiet/klinik",
      "art": "gebiet",
      "name": "Klinik und Therapie",
      "reihenfolge": 2,
      "auftakt": "Hier geht es um Menschen, deren Erleben ihnen zur Last wird, und um Verfahren, die helfen sollen. Das Gebiet ist ernst und nüchtern; du bestimmst das Tempo.",
      "abschluss": "Du hast beide Seiten gesehen: wie man Gedanken prüft und wie Belastendes das Gehirn prägt. Vieles ist gut belegt, manches wird noch gestritten."
    },
    {
      "id": "episode/verzerrung",
      "art": "episode",
      "name": "Kognitive Verzerrungen",
      "in": "gebiet/wirklichkeit",
      "etappe": "onboarding",
      "reihenfolge": 1,
      "adresse": "#/reise/verzerrung",
      "auftakt": "Du glaubst, du siehst die Welt, wie sie ist. Zwei Striche, eine Zahl und ein Wort werden dir zeigen, dass dein Kopf mit Abkürzungen arbeitet. Keine Sorge: Du wirst dabei nicht dümmer, nur ehrlicher mit dir selbst.",
      "abschluss": "Wer seine Denkfallen kennt, tappt trotzdem weiter hinein, nur mit mehr Humor. Du weißt jetzt, wo es sich lohnt, kurz innezuhalten, und wann eine Abkürzung einfach klug ist."
    },
    {
      "id": "episode/trauma",
      "art": "episode",
      "name": "Psychotraumatologie",
      "in": "gebiet/klinik",
      "etappe": "endgame",
      "reihenfolge": 3,
      "adresse": "#/reise/trauma",
      "auftakt": "Manche Erfahrungen sind zu groß, um sich in eine normale Erinnerung einzufügen. Diese Reise ist ernst; sie führt nicht in die Dunkelheit hinein, sondern durch sie hindurch. Geh in deinem Tempo und mach Pausen, wann du willst.",
      "abschluss": "Vieles über Trauma ist inzwischen gut verstanden, vieles wird noch gestritten. Wenn dich etwas persönlich berührt hat: Sprich mit jemandem, dem du vertraust. Hilfsangebote findest du unten auf jeder Seite."
    },
    {
      "id": "episode/kvt",
      "art": "episode",
      "name": "Kognitive Verhaltenstherapie",
      "in": "gebiet/klinik",
      "etappe": "scaffolding",
      "reihenfolge": 2,
      "adresse": "#/reise/kvt",
      "auftakt": "Was wäre, wenn nicht die Dinge selbst uns aufwühlen, sondern das, was wir über sie denken? Von einem Satz aus der Antike führt die Reise zu einem Werkzeugkasten, den du Station für Station selbst in die Hand nimmst.",
      "abschluss": "Die Verhaltenstherapie ist gut erforscht, aber nicht allmächtig, und manchmal genügt es vielleicht, Gedanken nur anzuschauen. Ein paar Werkzeuge hast du jetzt; ob und wann du sie brauchst, entscheidest du."
    },
